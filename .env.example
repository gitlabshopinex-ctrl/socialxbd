# PostgreSQL (local sandbox database used by Drizzle)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Supabase — canonical store for all social text data (users, posts, comments,
# likes, saves, follows, reports, moderation logs). Run supabase/schema.sql once.
# Server-only: never prefix with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Shopinex Media API — photos & videos storage (max 200 MB per file).
# Server-only: the API key is used exclusively by backend routes.
SHOPINEX_SITE_ID=socialx-fd44f774
SHOPINEX_API_KEY=
